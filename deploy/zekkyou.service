[Unit]
Description=Zekkyou resident agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/zekkyou/current
EnvironmentFile=%h/.config/zekkyou/service.env
ExecStart=%h/.local/opt/zekkyou/current/bin/zekkyou-cli serve %h/.config/zekkyou/service.exs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
